# Copy to .env if overriding local ports. Credentials live in .secrets/local.
# Generate once with: python scripts/bootstrap.py secrets
COMPOSE_PROJECT_NAME=nic-msi-expert
EXPERT_FRONTEND_PORT=8080
EXPERT_PUBLIC_BASE_URL=http://localhost:8080
EXPERT_LOG_LEVEL=INFO
# Optional diagnostics overlay publishes only loopback:
EXPERT_BACKEND_PORT=18080
EXPERT_POSTGRES_PORT=25432
EXPERT_REDIS_PORT=56379
EXPERT_S3_PORT=59000
EXPERT_S3_CONSOLE_PORT=59001
EXPERT_AGENT_PORT=18081
EXPERT_INGESTION_PORT=18082
EXPERT_OUTBOX_PORT=18083
EXPERT_JAEGER_PORT=16687
# Compose injects EXPERT_*_FILE values from per-service secret mounts.
# Public viewer/operator/admin access keys are separate files mounted only in backend.
# Never put their values in .env; bootstrap creates them without replacing existing keys.
# Model inference uses verified local snapshots, never downloads at startup.
EXPERT_RERANKER_DEVICE=cpu
EXPERT_RERANKER_CUDA_MAX_BATCH_TOKENS=2048
# To use cuda, build/run with -f infra/compose/reranker-gpu.yaml as the final overlay.
# Both cpu and cuda modes work in that GPU-capable image. The base image is CPU-only.
