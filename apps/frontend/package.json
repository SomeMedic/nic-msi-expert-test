{
  "name": "@digital-expert/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "gen:api": "openapi-typescript ../../contracts/openapi.json -o src/api/generated.ts --alphabetize --enum-values",
    "gen:api:check": "openapi-typescript ../../contracts/openapi.json -o src/api/generated.ts --alphabetize --enum-values --check",
    "typecheck": "tsc -b --pretty false",
    "build": "pnpm gen:api:check && pnpm typecheck && vite build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.1"
  }
}

